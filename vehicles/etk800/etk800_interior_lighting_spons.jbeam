{
"etk800_spons_interior_lights_sedan": {
    "information":{
        "authors":"Niclas Ryge",
        "name":"Interior lighting",
        "value":10
    },
    "slotType" : "etk800_spons_interior_lighting_s",
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         {"deformGroup":""}
    ],
    "components": {
        "electrics": {
            "customValues": [
                ["electricsName", "electricsFunction","electricsDefault"],
                ["InteriorLight", "clamp(electrics.door_FL_coupler_notAttached + electrics.door_FR_coupler_notAttached + electrics.door_RL_coupler_notAttached + electrics.door_RR_coupler_notAttached, 0, 1)", 0],
            ]
            "smoothers": [
                ["electricsName", "smootherType", "params"],
                ["InteriorLight","temporalNonLinear", [1]]
            ],
        }
    },
    //Temporarily unused
	"glowMap":{

    },
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$R", "range", "Color", "interior lighting",  200, 0, 255, "Interior color (red)", "Changes interior color"],
        ["$G", "range", "Color", "interior lighting",  225, 0, 255, "Interior color (green)", "Changes interior color"],
        ["$B", "range", "Color", "interior lighting",  255, 0, 255, "Interior color (blue)", "Changes interior color"]
    ],
    "props": [
        ["func"      , "mesh"              , "idRef:", "idX:", "idY:"            , "baseRotation"        , "rotation"                 , "translation"        , "min", "max", "offset", "multiplier"],
        {
            "lightInnerAngle":20,
            "lightOuterAngle":60,
            "lightBrightness":1.0,
            "lightRange":1,
            "lightColor":{"r":"$R", "g":"$G", "b":"$B", "a":255},
            "lightAttenuation":{"x":0, "y":1, "z":1},
            "lightCastShadows":false,
            "flareName":"vehicleHeadLightFlare",
            "flareScale":0,
            "cookieName":"/art/special/BNG_light_cookie_lightbar.dds",
            "texSize":128,
            "shadowSoftness":0.4
        },
        //Overhead driver pointlights
        ["InteriorLight", "POINTLIGHT", "rf1", "dsh1", "rf2",   {"x":110.827, "y":-156.751, "z":80.917},{"x":0, "y":0, "z":1},{"x":0, "y":0, "z":0}, 0, 0, 0, 1, {"baseTranslation":{"x":0.145, "y":0.115, "z":0.0},"deformGroup":"","lightBrightness":1.3, "lightScaling":{}}],

        //rear seats overhead
        ["InteriorLight", "POINTLIGHT", "rf4", "tb2", "rf3",    {"x":-87.109, "y":-51.780, "z":-17.375},{"x":0, "y":0, "z":1},{"x":0, "y":0, "z":0}, 0, 0, 0, 1, {"baseTranslation":{"x":0.177, "y":0.375, "z":0.0},"deformGroup":"","lightBrightness":1.1, "lightScaling":{}}],
        {
            "lightInnerAngle":10,
            "lightOuterAngle":60,
            "lightRange":0.58,
            "lightBrightness":1.5
        },
        //Footwell driver
        ["InteriorLight", "POINTLIGHT", "dsh3", "dsh2", "dsh1",     {"x":-113.261, "y":152.040, "z":-8.047},{"x":0, "y":0, "z":1},{"x":0, "y":0, "z":0}, 0, 0, 0, 1, {"baseTranslation":{"x":7.045, "y":-3.155, "z":0.440},"deformGroup":"","lightBrightness":1.1, "lightScaling":{}}],


        //trunk
        {
            "lightRange":0.8,
            "lightColor":{"r":200, "g":220, "b":255, "a":255}
        },
        ["tailgateCoupler_notAttached", "POINTLIGHT", "tb2", "tb1", "rf4",   {"x":-103.248, "y":-159.314, "z":82.172},{"x":0, "y":0, "z":1},{"x":0, "y":0, "z":0}, 0, 0, 0, 1, {"baseTranslation":{"x":0.907, "y":-0.298, "z":0},"deformGroup":"","lightBrightness":2.1}]

    ]
},

